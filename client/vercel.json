{
  "version": 2,
  "name": "mobilebuyer-in",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "framework": "create-react-app",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_GOOGLE_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbz5htoRiwm3d9yOso1e55sSxWdZJOnK2UZPJVguXFxKc-IeS8BoS4vMB3_GaI_JoKLq/exec"
  },
  "build": {
    "env": {
      "CI": "false",
      "REACT_APP_GOOGLE_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbz5htoRiwm3d9yOso1e55sSxWdZJOnK2UZPJVguXFxKc-IeS8BoS4vMB3_GaI_JoKLq/exec"
    }
  }
}